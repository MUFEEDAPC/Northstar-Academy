---
import PageFrame from '../components/layout/PageFrame.astro';
import HeroScene from '../components/three/HeroScene.jsx';
import { learningTopics } from '../data/learning-topics.js';
import { projectIdeas } from '../data/project-ideas.js';
---

<PageFrame
  title="Northstar Academy Kozhikode | Technology learning test project"
  description="Northstar Academy is a transparent test website exploring technology and digital-learning topics and Kozhikode/Calicut search intent. It is not an operating academy or course provider."
>
  <main id="main-content" tabindex="-1">
    <section class="hero wrap" id="home">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-dot"></span> NORTHSTAR ACADEMY · TEST PROJECT</div>
        <h1>Explore technology<br /><span>learning topics.</span></h1>
        <p class="hero-lede">A transparent website test about AI, web development, digital marketing, design, and data topics. Northstar Academy is not an operating academy and does not offer enrollment.</p>
        <div class="hero-actions"><a class="button button-dark" href="/courses/">Browse topic guides <span>↗</span></a><a class="button button-outline" href="/locations/kozhikode/">Kozhikode research guide</a></div>
        <div class="hero-proof"><span><b>✓</b> Educational topic guides</span><span><b>✓</b> No course enrollment</span><span><b>✓</b> Transparent test project</span></div>
      </div>
      <div class="hero-visual">
        <div class="visual-halo" aria-hidden="true"></div>
        <div class="hero-static-visual" aria-hidden="true" style="position:absolute;inset:0;z-index:1;width:100%;height:100%;pointer-events:none">
          <svg viewBox="0 0 600 500" preserveAspectRatio="xMidYMid meet" focusable="false" style="display:block;width:100%;height:100%">
            <defs>
              <radialGradient id="knowledge-fill" cx="35%" cy="28%"><stop offset="0" stop-color="#f4fbff"/><stop offset=".65" stop-color="#cceafa"/><stop offset="1" stop-color="#a9d2ed"/></radialGradient>
              <linearGradient id="card-fill" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff"/><stop offset="1" stop-color="#f5f9fc"/></linearGradient>
              <filter id="soft-shadow" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="10" stdDeviation="10" flood-color="#315879" flood-opacity=".12"/></filter>
            </defs>
            <ellipse class="hero-orbit hero-orbit-one" cx="300" cy="250" rx="216" ry="106" fill="none" stroke="#9bbbd2" stroke-opacity=".48" stroke-width="1.2" transform="rotate(-24 300 250)"/>
            <ellipse class="hero-orbit hero-orbit-two" cx="300" cy="250" rx="205" ry="145" fill="none" stroke="#a7c7dc" stroke-opacity=".35" stroke-width="1" transform="rotate(48 300 250)"/>
            <path d="M120 194 232 226M370 221 478 188M145 312 234 282M365 280 455 318" fill="none" stroke="#8ab7d2" stroke-opacity=".48" stroke-width="1.3" stroke-dasharray="3 6"/>
            <g class="hero-knowledge-core"><circle cx="300" cy="250" r="91" fill="url(#knowledge-fill)" stroke="#94c2df" stroke-opacity=".7"/><circle cx="300" cy="250" r="69" fill="none" stroke="#6ba4ce" stroke-opacity=".38" stroke-width="1"/><ellipse cx="300" cy="250" rx="33" ry="69" fill="none" stroke="#6ba4ce" stroke-opacity=".42" stroke-width="1"/><ellipse cx="300" cy="250" rx="69" ry="25" fill="none" stroke="#6ba4ce" stroke-opacity=".38" stroke-width="1"/><circle cx="271" cy="225" r="4" fill="#568fbe"/><circle cx="329" cy="238" r="4" fill="#56aeb9"/><circle cx="307" cy="282" r="4" fill="#777fd2"/><path d="m273 225 55 13-21 44-34-57" fill="none" stroke="#658fbc" stroke-opacity=".6" stroke-width="1.2"/></g>
            <g class="hero-float-card hero-float-one" filter="url(#soft-shadow)"><rect x="53" y="143" width="126" height="76" rx="12" fill="url(#card-fill)" stroke="#deebf3"/><rect x="66" y="157" width="27" height="27" rx="8" fill="#edf5fb"/><path d="m74 164 5 5-5 5m9 0h5" fill="none" stroke="#4c86b4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><text x="66" y="202" fill="#415a70" font-size="11" font-family="DM Sans, sans-serif" font-weight="700" letter-spacing="1">LEARN</text></g>
            <g class="hero-float-card hero-float-two" filter="url(#soft-shadow)"><rect x="424" y="142" width="126" height="76" rx="12" fill="url(#card-fill)" stroke="#deebf3"/><rect x="437" y="156" width="27" height="27" rx="8" fill="#eef2fb"/><path d="m444 169 6-6 6 6-6 6z" fill="none" stroke="#777fc0" stroke-width="1.5"/><text x="437" y="201" fill="#415a70" font-size="11" font-family="DM Sans, sans-serif" font-weight="700" letter-spacing="1">BUILD</text></g>
            <g class="hero-float-card hero-float-three" filter="url(#soft-shadow)"><rect x="82" y="316" width="126" height="76" rx="12" fill="url(#card-fill)" stroke="#deebf3"/><rect x="95" y="330" width="27" height="27" rx="8" fill="#eef7f5"/><path d="m101 350 5-12 4 7 4-5 3 10" fill="none" stroke="#4e9b8d" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text x="95" y="375" fill="#415a70" font-size="11" font-family="DM Sans, sans-serif" font-weight="700" letter-spacing="1">CREATE</text></g>
            <g class="hero-float-card hero-float-four" filter="url(#soft-shadow)"><rect x="392" y="315" width="126" height="76" rx="12" fill="url(#card-fill)" stroke="#deebf3"/><rect x="405" y="329" width="27" height="27" rx="8" fill="#f3f0fb"/><path d="m411 349 5-5 4 2 6-8" fill="none" stroke="#8177bd" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text x="405" y="374" fill="#415a70" font-size="11" font-family="DM Sans, sans-serif" font-weight="700" letter-spacing="1">GROW</text></g>
            <circle cx="205" cy="108" r="3" fill="#70b5ca"/><circle cx="394" cy="104" r="2.5" fill="#8d9ed3"/><circle cx="216" cy="412" r="2.5" fill="#79aec5"/><circle cx="374" cy="404" r="3" fill="#8498cc"/>
          </svg>
        </div>
        <HeroScene client:idle />
      </div>
      <div class="hero-bottom"><span>EDUCATIONAL TOPIC GUIDES</span><span>01 — 04</span></div>
    </section>

    <section class="section why-section" id="about"><div class="wrap">
      <div class="section-heading"><div><div class="eyebrow">A USEFUL PLACE TO START</div><h2>Compare learning topics<br />with <span>clear questions.</span></h2></div><p>This test project offers research prompts for evaluating real courses and providers. It does not make claims about a school or its programs.</p></div>
      <div class="benefits-grid">
        <article class="benefit-card"><div class="line-icon">⌘</div><h3>Understand the topic</h3><p>Review what a subject involves before comparing course outlines from real providers.</p><a href="/courses/" aria-label="Browse educational topic guides">↗</a></article>
        <article class="benefit-card"><div class="line-icon">▱</div><h3>Check practical work</h3><p>Ask what exercises or projects are included and how they relate to your goals.</p><a href="/projects/" aria-label="Read illustrative project prompts">↗</a></article>
        <article class="benefit-card"><div class="line-icon">◎</div><h3>Verify the details</h3><p>Confirm format, prerequisites, fees, schedule, and support directly with the provider.</p><a href="/faq/" aria-label="Read questions about provider details">↗</a></article>
        <article class="benefit-card"><div class="line-icon">↗</div><h3>Research locally</h3><p>Use a consistent checklist when comparing education options in Kozhikode or Calicut.</p><a href="/locations/kozhikode/" aria-label="Read the Kozhikode learning research guide">↗</a></article>
      </div>
    </div></section>

    <section class="section journey-section" id="journey"><div class="wrap">
      <div class="section-heading centered"><div><div class="eyebrow">A PROVIDER-COMPARISON CHECKLIST</div><h2>Choose with <span>good information.</span></h2></div><p>These steps are general research advice, not an enrollment path offered by Northstar Academy.</p></div>
      <div class="journey-track"><div class="track-line"><span></span></div>
        <article class="journey-step"><div class="step-number">01</div><div class="step-symbol">⌕</div><h3>Set a goal</h3><p>Write down the skill you want to use.</p></article>
        <article class="journey-step"><div class="step-number">02</div><div class="step-symbol">▤</div><h3>Compare topics</h3><p>Read the provider's published outline.</p></article>
        <article class="journey-step"><div class="step-number">03</div><div class="step-symbol">⌘</div><h3>Check practice</h3><p>Ask what work learners complete.</p></article>
        <article class="journey-step"><div class="step-number">04</div><div class="step-symbol">↻</div><h3>Verify terms</h3><p>Confirm format, fees, and prerequisites.</p></article>
        <article class="journey-step"><div class="step-number">05</div><div class="step-symbol">↗</div><h3>Contact them</h3><p>Use the provider's official channel.</p></article>
      </div>
    </div></section>

    <section class="section courses-section" id="courses"><div class="wrap">
      <div class="section-heading"><div><div class="eyebrow">EDUCATIONAL GUIDES · NOT COURSES</div><h2>Explore learning<br /><span>topics.</span></h2></div><p>These are the four topics already presented by this test website. They are not confirmed course offerings or an enrollment catalog.</p></div>
      <div class="courses-grid">{learningTopics.map((topic) => <article class="course-card">
        <div class={`course-art ${topic.tone}`} aria-hidden="true"><div class="course-art-orbit"></div><span>{topic.icon}</span><small>{topic.category}</small></div>
        <div class="course-content"><h3>{topic.title}</h3><p>{topic.cardDescription}</p><div class="course-foot"><span>Educational guide</span><a href={`/courses/${topic.slug}/`} aria-label={`Read the ${topic.title} topic guide`}>Read guide <b>↗</b></a></div></div>
      </article>)}</div>
      <div class="all-courses"><a class="text-link" href="/courses/">View all topic guides <span>↗</span></a></div>
    </div></section>

    <section class="ai-section" id="ai"><div class="wrap ai-layout"><div class="ai-copy"><div class="eyebrow light"><span class="eyebrow-dot"></span> TOPIC OVERVIEW · NOT A PROGRAM</div><h2>Explore AI in<br /><span>web development.</span></h2><p>AI tools can assist parts of a web workflow, but people still need to understand the code, review outputs, and test usability. This site does not teach or certify these skills.</p><a class="button button-white" href="/courses/ai-web-development/">Read the topic guide <span>↗</span></a><div class="ai-tags"><span>AI tools</span><span>Web development</span><span>Code review</span><span>Testing</span></div></div>
        <div class="ai-visual" aria-hidden="true"><div class="ai-lines"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="ai-center"><div class="ai-core">✳</div><small>AI TOPIC</small></div><div class="ai-node n1">⌘<small>Code</small></div><div class="ai-node n2">◈<small>Design</small></div><div class="ai-node n3">↗<small>Review</small></div><div class="ai-node n4">▥<small>Test</small></div><div class="ai-node n5">✎<small>Write</small></div><div class="ai-node n6">⌁<small>Tools</small></div></div>
      </div></section>

    <section class="section network-section"><div class="wrap network-layout"><div class="network-visual" aria-hidden="true"><div class="world-orbit orbit-a"></div><div class="world-orbit orbit-b"></div><div class="world-globe"><div class="globe-grid"></div><span class="globe-node gn1"></span><span class="globe-node gn2"></span><span class="globe-node gn3"></span><span class="globe-node gn4"></span><span class="globe-node gn5"></span></div><div class="network-label label-students">● Research</div><div class="network-label label-mentors">● Compare</div><div class="network-label label-projects">● Verify</div><div class="network-label label-teams">● Decide</div></div><div class="network-copy"><div class="eyebrow">KOZHIKODE / CALICUT</div><h2>Research local<br /><span>learning options</span><br />with care.</h2><p>This site is not a Kozhikode academy. Its local guide helps visitors assess information published by real providers without implying a Northstar campus or service.</p><a class="text-link" href="/locations/kozhikode/">Open the Kozhikode research guide <span>↗</span></a></div></div></section>

    <section class="section projects-section" id="projects"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">ILLUSTRATIVE PROMPTS</div><h2>Ideas for learning<br /><span>by doing.</span></h2></div><p>These are hypothetical examples, not completed student projects or academy outcomes.</p></div><div class="project-grid">{projectIdeas.map((project, index) => <article class={`project-card project-${index + 1}`}><div class="project-preview" aria-hidden="true"><div class="preview-window"><span></span><span></span><span></span><div class="preview-shape">{index === 0 ? '▤' : index === 1 ? '✳' : '▥'}</div><div class="preview-lines"><i></i><i></i><i></i></div></div><div class="project-index">0{index + 1}</div></div><div class="project-info"><small>Example prompt · {project.category}</small><h3>{project.title}</h3><p>{project.brief}</p><div class="project-tags"><span>Not student work</span></div></div></article>)}</div><div class="all-courses"><a class="text-link" href="/projects/">Read the project prompts <span>↗</span></a></div></div></section>

    <section class="section experience-section" id="experience"><div class="wrap"><div class="section-heading centered"><div><div class="eyebrow">QUESTIONS BEFORE YOU CHOOSE</div><h2>A practical provider<br />comparison <span>checklist.</span></h2></div><p>Verify details with the real school or training provider. This website does not verify local providers.</p></div><div class="experience-timeline"><div class="experience-line"></div>{[['01','Syllabus','Does the outline name topics and skills?'],['02','Practice','What exercises or projects are included?'],['03','Starting level','Are prerequisites and expectations stated?'],['04','Format','How and when does learning take place?'],['05','Costs','Are fees and terms clearly published?'],['06','Evidence','Can you verify staff, work, and outcomes?']].map((item) => <article class="experience-step"><span>{item[0]}</span><div><h3>{item[1]}</h3><p>{item[2]}</p></div></article>)}</div></div></section>

    <section class="cta-section" id="contact"><div class="cta-grid" aria-hidden="true"></div><div class="cta-node node-1" aria-hidden="true"></div><div class="cta-node node-2" aria-hidden="true"></div><div class="cta-node node-3" aria-hidden="true"></div><div class="wrap cta-inner"><div class="eyebrow light">A TRANSPARENT TEST PROJECT</div><h2>Research first.<br /><span>Choose carefully.</span></h2><p>Northstar Academy does not accept enrollment. Use these guides to prepare questions for providers you independently verify.</p><div class="hero-actions"><a class="button button-white" href="/faq/">Read the FAQ <span>↗</span></a><a class="button button-ghost" href="/contact/">Project status <span>↗</span></a></div></div></section>
  </main>
  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries, observer) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }), { threshold: .18 });
      document.querySelectorAll('.benefit-card,.course-card,.journey-step,.project-card,.experience-step,.section-heading,.network-visual,.ai-visual').forEach((el) => io.observe(el));
      const line = document.querySelector('.track-line span');
      if (line) {
        const lineObserver = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            line.classList.add('drawn');
            lineObserver.disconnect();
          }
        }, { threshold: 0.4 });
        lineObserver.observe(line);
      }
    }
  </script>
</PageFrame>
