---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Northstar Academy" description="The page you requested could not be found." noindex={true}>
  <main class="not-found wrap" id="main-content" tabindex="-1">
    <div class="eyebrow">404 · PAGE NOT FOUND</div>
    <h1>That page isn't here.</h1>
    <p>The address may be incorrect, or the page may have moved.</p>
    <a class="button button-dark" href="/">Return to Northstar Academy <span>↗</span></a>
  </main>
</Layout>
