---
import Layout from '../layouts/Layout.astro';
import HeroScene from '../components/three/HeroScene.jsx';
const courses = [
  { icon: '✳', kind:'AI & DEVELOPMENT', title: 'AI Web Development', text: 'Build modern websites and applications with AI-assisted workflows.', tone:'blue' },
  { icon: '↗', kind:'GROWTH & STRATEGY', title: 'Digital Marketing', text: 'Turn customer insight into campaigns that deliver measurable growth.', tone:'violet' },
  { icon: '◉', kind:'DESIGN & CREATIVE', title: 'Product Design', text: 'Shape thoughtful digital experiences from first sketch to prototype.', tone:'coral' },
  { icon: '▦', kind:'DATA & ANALYTICS', title: 'Data Analytics', text: 'Find the signal in complex data and communicate insights with clarity.', tone:'mint' },
];
const projects = [ ['E-commerce Platform','Web Development','Product pages, a basket and checkout flow'], ['AI Support Assistant','Artificial Intelligence','A conversational interface for common questions'], ['Growth Analytics Dashboard','Data & Marketing','A dashboard for exploring campaign performance'] ];
---
<Layout>
  <header class="site-header" id="top">
    <nav class="nav wrap" aria-label="Main navigation">
      <a class="brand" href="#top" aria-label="Northstar Academy home"><span class="brand-mark"><span></span><span></span><span></span></span><span>northstar<span class="brand-academy"> academy</span></span></a>
      <button class="menu-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-links"><span></span><span></span></button>
      <div class="nav-links" id="primary-links"><a href="#home">Home</a><a href="#courses">Courses</a><a href="#journey">Programs</a><a href="#about">About</a><a href="#experience">Learning</a><a href="#contact">Contact</a></div>
      <a class="button button-dark nav-cta" href="#courses">Explore courses <span>↗</span></a>
    </nav>
  </header>
  <main id="main-content" tabindex="-1">
    <section class="hero wrap" id="home">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-dot"></span> THE FUTURE OF LEARNING</div>
        <h1>Learn today.<br /><span>Build tomorrow.</span></h1>
        <p class="hero-lede">Learn practical skills, build real-world projects, and prepare for the future of technology.</p>
        <div class="hero-actions"><a class="button button-dark" href="#courses">Explore courses <span>↗</span></a><a class="button button-outline" href="#journey"><span class="play-icon">▶</span> Start learning</a></div>
        <div class="hero-proof"><span><b>✓</b> Industry-focused learning</span><span><b>✓</b> Practical projects</span><span><b>✓</b> Expert mentorship</span></div>
      </div>
      <div class="hero-visual">
        <div class="visual-halo" aria-hidden="true"></div>
        <div class="hero-static-visual" aria-hidden="true" style="position:absolute;inset:0;z-index:1;width:100%;height:100%;pointer-events:none">
          <svg viewBox="0 0 600 500" preserveAspectRatio="xMidYMid meet" focusable="false" style="display:block;width:100%;height:100%">
            <defs>
              <radialGradient id="knowledge-fill" cx="35%" cy="28%"><stop offset="0" stop-color="#f4fbff"/><stop offset=".65" stop-color="#cceafa"/><stop offset="1" stop-color="#a9d2ed"/></radialGradient>
              <linearGradient id="card-fill" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff"/><stop offset="1" stop-color="#f5f9fc"/></linearGradient>
              <filter id="soft-shadow" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="10" stdDeviation="10" flood-color="#315879" flood-opacity=".12"/></filter>
            </defs>
            <ellipse class="hero-orbit hero-orbit-one" cx="300" cy="250" rx="216" ry="106" fill="none" stroke="#9bbbd2" stroke-opacity=".48" stroke-width="1.2" transform="rotate(-24 300 250)"/>
            <ellipse class="hero-orbit hero-orbit-two" cx="300" cy="250" rx="205" ry="145" fill="none" stroke="#a7c7dc" stroke-opacity=".35" stroke-width="1" transform="rotate(48 300 250)"/>
            <path d="M120 194 232 226M370 221 478 188M145 312 234 282M365 280 455 318" fill="none" stroke="#8ab7d2" stroke-opacity=".48" stroke-width="1.3" stroke-dasharray="3 6"/>
            <g class="hero-knowledge-core">
              <circle cx="300" cy="250" r="91" fill="url(#knowledge-fill)" stroke="#94c2df" stroke-opacity=".7"/>
              <circle cx="300" cy="250" r="69" fill="none" stroke="#6ba4ce" stroke-opacity=".38" stroke-width="1"/>
              <ellipse cx="300" cy="250" rx="33" ry="69" fill="none" stroke="#6ba4ce" stroke-opacity=".42" stroke-width="1"/>
              <ellipse cx="300" cy="250" rx="69" ry="25" fill="none" stroke="#6ba4ce" stroke-opacity=".38" stroke-width="1"/>
              <circle cx="271" cy="225" r="4" fill="#568fbe"/><circle cx="329" cy="238" r="4" fill="#56aeb9"/><circle cx="307" cy="282" r="4" fill="#777fd2"/>
              <path d="m273 225 55 13-21 44-34-57" fill="none" stroke="#658fbc" stroke-opacity=".6" stroke-width="1.2"/>
            </g>
            <g class="hero-float-card hero-float-one" filter="url(#soft-shadow)"><rect x="53" y="143" width="126" height="76" rx="12" fill="url(#card-fill)" stroke="#deebf3"/><rect x="66" y="157" width="27" height="27" rx="8" fill="#edf5fb"/><path d="m74 164 5 5-5 5m9 0h5" fill="none" stroke="#4c86b4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><text x="66" y="202" fill="#415a70" font-size="11" font-family="DM Sans, sans-serif" font-weight="700" letter-spacing="1">LEARN</text></g>
            <g class="hero-float-card hero-float-two" filter="url(#soft-shadow)"><rect x="424" y="142" width="126" height="76" rx="12" fill="url(#card-fill)" stroke="#deebf3"/><rect x="437" y="156" width="27" height="27" rx="8" fill="#eef2fb"/><path d="m444 169 6-6 6 6-6 6z" fill="none" stroke="#777fc0" stroke-width="1.5"/><text x="437" y="201" fill="#415a70" font-size="11" font-family="DM Sans, sans-serif" font-weight="700" letter-spacing="1">BUILD</text></g>
            <g class="hero-float-card hero-float-three" filter="url(#soft-shadow)"><rect x="82" y="316" width="126" height="76" rx="12" fill="url(#card-fill)" stroke="#deebf3"/><rect x="95" y="330" width="27" height="27" rx="8" fill="#eef7f5"/><path d="m101 350 5-12 4 7 4-5 3 10" fill="none" stroke="#4e9b8d" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text x="95" y="375" fill="#415a70" font-size="11" font-family="DM Sans, sans-serif" font-weight="700" letter-spacing="1">CREATE</text></g>
            <g class="hero-float-card hero-float-four" filter="url(#soft-shadow)"><rect x="392" y="315" width="126" height="76" rx="12" fill="url(#card-fill)" stroke="#deebf3"/><rect x="405" y="329" width="27" height="27" rx="8" fill="#f3f0fb"/><path d="m411 349 5-5 4 2 6-8" fill="none" stroke="#8177bd" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text x="405" y="374" fill="#415a70" font-size="11" font-family="DM Sans, sans-serif" font-weight="700" letter-spacing="1">GROW</text></g>
            <circle cx="205" cy="108" r="3" fill="#70b5ca"/><circle cx="394" cy="104" r="2.5" fill="#8d9ed3"/><circle cx="216" cy="412" r="2.5" fill="#79aec5"/><circle cx="374" cy="404" r="3" fill="#8498cc"/>
          </svg>
        </div>
        <HeroScene client:idle />
      </div>
      <div class="hero-bottom"><span>SKILLS FOR WHAT'S NEXT</span><span>01 — 06</span></div>
    </section>

    <section class="section why-section" id="about"><div class="wrap">
      <div class="section-heading"><div><div class="eyebrow">A BETTER WAY TO GROW</div><h2>Learning designed for<br />the <span>real world.</span></h2></div><p>Make progress that travels with you. Every course turns current industry practice into skills you can put to work.</p></div>
      <div class="benefits-grid">
        <article class="benefit-card"><div class="line-icon">⌘</div><h3>Learn by building</h3><p>Work on practical projects instead of only watching lectures. Make ideas tangible from day one.</p><a href="#projects" aria-label="Explore project learning">↗</a></article>
        <article class="benefit-card"><div class="line-icon">▱</div><h3>Industry skills</h3><p>Build confidence with the tools, workflows and thinking used by modern teams.</p><a href="#courses" aria-label="Explore industry courses">↗</a></article>
        <article class="benefit-card"><div class="line-icon">◎</div><h3>Expert mentorship</h3><p>Get thoughtful feedback and practical guidance from people doing the work.</p><a href="#experience" aria-label="Explore mentorship experience">↗</a></article>
        <article class="benefit-card"><div class="line-icon">↗</div><h3>Career focused</h3><p>Build a portfolio of evidence that helps you move toward your next opportunity.</p><a href="#projects" aria-label="Explore career projects">↗</a></article>
      </div>
    </div></section>

    <section class="section journey-section" id="journey"><div class="wrap">
      <div class="section-heading centered"><div><div class="eyebrow">SMALL STEPS, BIG MOMENTUM</div><h2>Your learning <span>journey.</span></h2></div><p>A clear path from curiosity to capability. Learn at your pace, with real support at every stage.</p></div>
      <div class="journey-track"><div class="track-line"><span></span></div>
        <article class="journey-step"><div class="step-number">01</div><div class="step-symbol">⌕</div><h3>Discover</h3><p>Find the skills that fit your goals.</p></article>
        <article class="journey-step"><div class="step-number">02</div><div class="step-symbol">▤</div><h3>Learn</h3><p>Build a strong foundation with experts.</p></article>
        <article class="journey-step"><div class="step-number">03</div><div class="step-symbol">⌘</div><h3>Build</h3><p>Turn new knowledge into real work.</p></article>
        <article class="journey-step"><div class="step-number">04</div><div class="step-symbol">↻</div><h3>Practice</h3><p>Refine your skills with feedback.</p></article>
        <article class="journey-step"><div class="step-number">05</div><div class="step-symbol">↗</div><h3>Launch</h3><p>Take your next step with confidence.</p></article>
      </div>
    </div></section>

    <section class="section courses-section" id="courses"><div class="wrap">
      <div class="section-heading"><div><div class="eyebrow">LEARN WHAT MOVES YOU</div><h2>Explore what you<br />can <span>learn.</span></h2></div><p>Focused, mentor-led programs built around the skills shaping today's work.</p></div>
      <div class="courses-grid">{courses.map((course) => <article class="course-card">
        <div class={`course-art ${course.tone}`}><div class="course-art-orbit"></div><span>{course.icon}</span><small>{course.kind}</small></div>
        <div class="course-content"><h3>{course.title}</h3><p>{course.text}</p><div class="course-foot"><span>Explore this topic</span><a href="#contact" aria-label={`Enquire about ${course.title}`}>Enquire <b>↗</b></a></div></div>
      </article>)}</div>
      <div class="all-courses"><a class="text-link" href="#contact">Ask us about learning paths <span>↗</span></a></div>
    </div></section>

    <section class="ai-section" id="ai"><div class="wrap ai-layout"><div class="ai-copy"><div class="eyebrow light"><span class="eyebrow-dot"></span> HUMAN SKILLS, AI POWERED</div><h2>Learn smarter<br />with <span>AI.</span></h2><p>AI is changing how we work. Learn to use it as a powerful tool — paired with the judgment, creativity and skills that make your work uniquely yours.</p><a class="button button-white" href="#courses">Explore AI learning <span>↗</span></a><div class="ai-tags"><span>Prompting</span><span>Automation</span><span>Creative tools</span><span>AI development</span></div></div>
        <div class="ai-visual" aria-hidden="true"><div class="ai-lines"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="ai-center"><div class="ai-core">✳</div><small>AI LEARNING</small></div><div class="ai-node n1">⌘<small>Code</small></div><div class="ai-node n2">◈<small>Design</small></div><div class="ai-node n3">↗<small>Marketing</small></div><div class="ai-node n4">▥<small>Analytics</small></div><div class="ai-node n5">✎<small>Writing</small></div><div class="ai-node n6">⌁<small>Automation</small></div></div>
      </div></section>

    <section class="section network-section"><div class="wrap network-layout"><div class="network-visual"><div class="world-orbit orbit-a"></div><div class="world-orbit orbit-b"></div><div class="world-globe"><div class="globe-grid"></div><span class="globe-node gn1"></span><span class="globe-node gn2"></span><span class="globe-node gn3"></span><span class="globe-node gn4"></span><span class="globe-node gn5"></span></div><div class="network-label label-students">● Students</div><div class="network-label label-mentors">● Mentors</div><div class="network-label label-projects">● Projects</div><div class="network-label label-teams">● Teams</div></div><div class="network-copy"><div class="eyebrow">LEARNING HAS NO BORDERS</div><h2>Connect with a<br /><span>global learning</span><br />ecosystem.</h2><p>Meet ambitious learners, generous mentors and teams who believe the best work happens when knowledge is shared.</p><a class="text-link" href="#contact">Meet the community <span>↗</span></a></div></div></section>

    <section class="section projects-section" id="projects"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">PROJECT IDEAS</div><h2>Don't just learn.<br /><span>Build.</span></h2></div><p>Example project briefs that connect learning topics to practical work.</p></div><div class="project-grid">{projects.map((project,i)=><article class={`project-card project-${i+1}`}><div class="project-preview" aria-hidden="true"><div class="preview-window"><span></span><span></span><span></span><div class="preview-shape">{i===0?'▤':i===1?'✳':'▥'}</div><div class="preview-lines"><i></i><i></i><i></i></div></div><div class="project-index">0{i+1}</div></div><div class="project-info"><small>Example · {project[1]}</small><h3>{project[0]}</h3><p>{project[2]}</p><div class="project-tags"><span>Example project idea</span></div></div></article>)}</div></div></section>

    <section class="section experience-section" id="experience"><div class="wrap"><div class="section-heading centered"><div><div class="eyebrow">SUPPORT THAT GOES FURTHER</div><h2>A student experience<br />built around <span>you.</span></h2></div><p>From your first lesson to your next big opportunity, keep moving with a plan and people in your corner.</p></div><div class="experience-timeline"><div class="experience-line"></div>{[['01','Enroll','Choose a path that meets you where you are.'],['02','Learn','Build foundations through focused lessons.'],['03','Practice','Try new skills in guided exercises.'],['04','Build','Create a project with real-world context.'],['05','Get feedback','Refine your work with mentor input.'],['06','Launch','Share your progress and take your next step.']].map((item)=><article class="experience-step"><span>{item[0]}</span><div><h3>{item[1]}</h3><p>{item[2]}</p></div></article>)}</div></div></section>

    <section class="cta-section" id="contact"><div class="cta-grid"></div><div class="cta-node node-1"></div><div class="cta-node node-2"></div><div class="cta-node node-3"></div><div class="wrap cta-inner"><div class="eyebrow light">YOUR NEXT CHAPTER STARTS HERE</div><h2>Your next skill<br />starts <span>here.</span></h2><p>Choose a skill. Start learning. Build something real.</p><div class="hero-actions"><a class="button button-white" href="#courses">Explore courses <span>↗</span></a><a class="button button-ghost" href="mailto:hello@northstar.academy">Talk to us <span>↗</span></a></div></div></section>
  </main>
  <footer class="footer"><div class="wrap"><div class="footer-main"><div class="footer-brand"><a class="brand" href="#top"><span class="brand-mark"><span></span><span></span><span></span></span><span>northstar<span class="brand-academy"> academy</span></span></a><p>Practical learning for a world that's always moving.</p><a class="footer-email" href="mailto:hello@northstar.academy">hello@northstar.academy ↗</a></div><div class="footer-column"><h3>Academy</h3><a href="#about">About us</a><a href="#experience">Our approach</a><a href="#contact">Contact</a></div><div class="footer-column"><h3>Courses</h3><a href="#courses">Technology</a><a href="#courses">Design</a><a href="#courses">Business & AI</a></div><div class="footer-column"><h3>Learning</h3><a href="#journey">Learning paths</a><a href="#projects">Project ideas</a><a href="#experience">Student experience</a></div></div><div class="footer-bottom"><span>© 2026 Northstar Academy. All rights reserved.</span><span>Contact: <a href="mailto:hello@northstar.academy">hello@northstar.academy</a></span></div></div></footer>
  <script>
    const header = document.querySelector('.site-header');
    const menu = document.querySelector('.menu-toggle');
    const links = document.querySelector('.nav-links');
    const syncHeader = () => header?.classList.toggle('scrolled', window.scrollY > 16);
    window.addEventListener('scroll', syncHeader, { passive: true }); syncHeader();
    const setMenuOpen = (open) => {
      menu?.setAttribute('aria-expanded', String(open));
      menu?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      links?.classList.toggle('open', open);
      document.body.classList.toggle('menu-open', open);
    };
    menu?.addEventListener('click', () => setMenuOpen(menu.getAttribute('aria-expanded') !== 'true'));
    links?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        menu.focus();
      }
    });
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries, observer) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }), { threshold: .18 });
      document.querySelectorAll('.benefit-card,.course-card,.journey-step,.project-card,.experience-step,.section-heading,.network-visual,.ai-visual').forEach(el=>io.observe(el));
      const line = document.querySelector('.track-line span');
      if (line) {
        const lineObserver = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            line.classList.add('drawn');
            lineObserver.disconnect();
          }
        }, { threshold: 0.4 });
        lineObserver.observe(line);
      }
    }
  </script>
</Layout>
